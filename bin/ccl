#!/bin/bash
# Claude Code on a local llama.cpp model (no rate limit, fully offline)
#
# Usage: ccl [-m MODEL] [--restart] [--pull] [-y] [-h] [claude args...]
#   -m, --model     qwen (default) | gemma | any id the router offers
#       --restart   Restart the router (use after editing the preset)
#       --pull      Allow downloading a model that is not cached
#   -y, --yolo      Pass --dangerously-skip-permissions to Claude Code
#   -h, --help      Show this help message
#
# Runs Claude Code against llama-server's native Anthropic endpoint
# (/v1/messages), no proxy needed. llama-server runs in ROUTER mode: one
# long-lived server offers every model in the preset and loads and unloads them
# on demand, so switching models is a different ANTHROPIC_MODEL rather than a
# restart. Models are declared in the preset, not in this script. For the free
# hosted tier use `ccnim` (NIM via Olla).

set -e

show_help() {
  sed -n '2,16s/^# \{0,1\}//p' "$0"
  exit 0
}

url="http://127.0.0.1:40115"
# Not /tmp/llama-server.log: Llama.app's own `llama serve` already writes there.
log=/tmp/ccl-llama-server.log
preset="${CCL_PRESET:-$HOME/.config/ccl/models.ini}"

restart=false
yolo=false
pull=false
model="qwen"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m | --model)
      [[ -n "${2:-}" ]] || {
        echo "ccl: -m requires a model id (see $preset)" >&2
        exit 1
      }
      model="$2"
      shift 2
      ;;
    # Long-only, both of these: claude owns -r (--resume) and -p (--print);
    # a short alias here would swallow either and change claude's own behaviour.
    --restart)
      restart=true
      shift
      ;;
    --pull)
      pull=true
      shift
      ;;
    -y | --yolo)
      yolo=true
      shift
      ;;
    -h | --help) show_help ;;
    *) break ;;
  esac
done

# tool:formula pairs — llama-server ships in the llama.cpp formula, so the
# brew-install hint below must name the formula, not the binary.
for tool in llama-server:llama.cpp jq:jq; do
  command -v "${tool%%:*}" >/dev/null || {
    echo "ccl: '${tool%%:*}' not found on PATH (brew install ${tool##*:})" >&2
    exit 1
  }
done

[[ -f "$preset" ]] || {
  echo "ccl: no model preset at $preset" >&2
  echo "     Expected a symlink to .config/ccl/models.ini in the dotfiles repo." >&2
  exit 1
}

server_up() { curl -sf -o /dev/null --max-time 2 "$url/health" 2>/dev/null; }

# Every jq call needs `|| true` at the call site: jq exits 5 on a non-JSON body
# (anything answering on :40115 satisfies curl -sf), and under bash 3.2 a
# failing command substitution aborts the script at the assignment.
models_json() { curl -sf --max-time 5 "$url/v1/models" 2>/dev/null || true; }
field() { jq -r --arg m "$model" ".data[]?|select(.id==\$m)|$1 // empty" <<<"$2" 2>/dev/null || true; }

# --offline is set only at router startup; compare want vs running state rather
# than always restarting on --pull, or a later plain `ccl` would silently reuse
# a non-offline router.
router_argv() {
  local p
  # Scoped to the port, matching the pkill selector below — a bare
  # --models-preset match could pick a different router and misreport its
  # --offline state as ours.
  p="$(pgrep -f 'llama-server .*--port 40115' 2>/dev/null | head -1)"
  [[ -n "$p" ]] && ps -o args= -p "$p" 2>/dev/null || true
}
want_offline=true
if $pull; then want_offline=false; fi
if server_up; then
  is_offline=false
  case "$(router_argv)" in
    *--offline*) is_offline=true ;;
  esac
  if [[ "$is_offline" != "$want_offline" ]]; then restart=true; fi
fi

if $restart && server_up; then
  pkill -f "llama-server .* --port 40115" 2>/dev/null || true
  # A bare sleep would race a still-shutting-down server and leave the old preset in force.
  n=0
  while server_up && [[ $n -lt 20 ]]; do
    sleep 0.5
    n=$((n + 1))
  done
  # Refuse rather than warn: continuing would run against a server this script
  # doesn't control, at exit 0, with the warning scrolled away by the TUI.
  if server_up; then
    echo "ccl: llama-server on :40115 did not stop, so the preset was not reloaded." >&2
    echo "     Stop it before rerunning: pkill -f 'llama-server .* 40115'" >&2
    exit 1
  fi
fi

if ! server_up; then
  # --offline is llama.cpp's own switch against fetching multi-GB weights nobody
  # asked for; it already knows the cache-relocation env vars and quant-tag
  # aliasing this script would otherwise have to reimplement. A preset stanza
  # is offered whether or not it's cached, so a miss surfaces at load time below.
  offline=(--offline)
  if $pull; then offline=(); fi
  # --models-max 1 (default 4): unified memory shares one budget across resident
  # models, so keeping more than one loaded here exceeds the Metal working-set
  # ceiling and the second model's first request dies with a compute error.
  nohup llama-server --models-preset "$preset" "${offline[@]}" --models-max 1 \
    --port 40115 --host 127.0.0.1 >"$log" 2>&1 &
  server_pid=$!
  disown
  echo "ccl: starting llama-server (router, $(basename "$preset"))" >&2
  n=0
  until server_up; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
      echo "ccl: llama-server exited during startup:" >&2
      tail -n 15 "$log" >&2
      exit 1
    fi
    if [[ $n -ge 120 ]]; then
      # Kill it rather than leak it: nohup+disown means the child outlives us,
      # and an unhealthy server would otherwise let the next run spawn a second one.
      echo "ccl: router not healthy after 60s; stopping it (see $log)" >&2
      kill "$server_pid" 2>/dev/null || true
      exit 1
    fi
    sleep 0.5
    n=$((n + 1))
  done
fi

json="$(models_json)"
status="$(field '.status.value' "$json")"
# No --pull hint here: a preset stanza is always listed, cached or not, so
# reaching this means the id isn't declared at all — --pull permits a download,
# it doesn't declare a model.
if [[ -z "$status" ]]; then
  echo "ccl: the router does not offer '$model'." >&2
  echo "     Add a stanza to $preset (then --restart), or pick one of:" >&2
  echo "     $(jq -r '[.data[]?|select(.source=="preset")|.id]|join(", ")' <<<"$json" 2>/dev/null || echo '?')" >&2
  exit 1
fi

# Loading is what populates meta.n_ctx — the only way to learn the window
# actually served, since llama.cpp silently clamps an oversized ctx-size rather
# than rejecting it, so the preset's number can't be trusted on its own.
if [[ "$status" != "loaded" ]]; then
  echo "ccl: loading $model" >&2
  # The router appends across loads; only search lines written by this one.
  log_mark=$(wc -l <"$log" 2>/dev/null | tr -d ' ')
  curl -sf --max-time 900 "$url/v1/messages" -H 'content-type: application/json' \
    -d "{\"model\":\"$model\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" \
    >/dev/null 2>&1 || {
    # The empty-path form is the cache miss; a corrupt gguf also matches "failed
    # to load model", so the tail below is what shows which one it was.
    if ! $pull && [[ "$(tail -n +"$((${log_mark:-0} + 1))" "$log" 2>/dev/null)" == *"failed to load model, ''"* ]]; then
      echo "ccl: $model is declared but not in the local cache; --pull to fetch it." >&2
      exit 1
    fi
    echo "ccl: $model failed to load:" >&2
    tail -n 15 "$log" >&2
    exit 1
  }
  json="$(models_json)"
fi

served_ctx="$(field '.meta.n_ctx' "$json")"
[[ "$served_ctx" =~ ^[1-9][0-9]*$ ]] || {
  # Say so rather than guess: a guessed window is exactly what reading it back prevents.
  echo "ccl: could not read n_ctx for $model from $url/v1/models" >&2
  exit 1
}
# Slot count comes from the child's resolved argv, not the preset we handed it.
# $i below is a jq binding, not a shell variable; the single quotes keep it that way.
# shellcheck disable=SC2016
slots="$(field '.status.args|index("--parallel") as $i|if $i then .[$i+1] else empty end' "$json")"
[[ "$slots" =~ ^[1-9][0-9]*$ ]] || slots=1

# ANTHROPIC_API_KEY (unused value) overrides an active Claude subscription
# login to force this endpoint.
#
# CLAUDE_CODE_MAX_CONTEXT_TOKENS, not --autocompact: that flag rejects anything
# below 100k, so a smaller preset ctx-size would die on argv parsing. Unset,
# Claude Code assumes a 200k window for an unrecognised model and overflows it.
#
# --dangerously-skip-permissions is opt-in (-y): once passed, --permission-mode
# manual can't override it and there's no --no- form, so it must never be default.
claude_args=()
if $yolo; then claude_args+=(--dangerously-skip-permissions); fi

# All four tier vars, not just ANTHROPIC_MODEL: the router 400s an unknown
# model name, and left unset, each tier resolves to a hardcoded claude-*
# literal, so `--model opus`, the /model picker, and any plugin agent pinning
# a tier fail mid-session.
ANTHROPIC_BASE_URL="$url" \
  ANTHROPIC_API_KEY="llama" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_SMALL_FAST_MODEL="$model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$model" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$model" \
  ANTHROPIC_DEFAULT_FABLE_MODEL="$model" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-$served_ctx}" \
  CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS="${CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS:-$slots}" \
  exec claude "${claude_args[@]}" "$@"
