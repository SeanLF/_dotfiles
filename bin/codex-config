#!/usr/bin/env python3
"""Keep the chosen part of ~/.codex/config.toml equal to the tracked copy.

    codex-config --check          exit 1 and list every owned key whose live value differs
    codex-config --apply          rewrite live: tracked wins on owned keys, live keeps the rest
    codex-config --render         print what --apply would write
    codex-config --hooks-trust    exit 1 and list hooks.json handlers with no recorded trust

Ownership is per top-level scalar or per second-level table: `model` and
`[mcp_servers.seanfloyd-dev]` are owned whole, so a subkey deleted from the
tracked copy is deleted from the live file too, while `[mcp_servers.node_repl]`,
`[projects.*]` and `[hooks.state]` (which Codex writes itself) are never touched.
A whole unit removed from the tracked copy is simply no longer owned; delete it
from the live file by hand (or `codex mcp remove`).
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import math
import os
import re
import shutil
import sys
import tomllib
from pathlib import Path
from typing import Any

FORBIDDEN_IN_TRACKED = (("projects",), ("hooks", "state"))
BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
EVENT_LABEL = {
    "PreToolUse": "pre_tool_use",
    "PermissionRequest": "permission_request",
    "PostToolUse": "post_tool_use",
    "PreCompact": "pre_compact",
    "PostCompact": "post_compact",
    "SessionStart": "session_start",
    "SessionEnd": "session_end",
    "UserPromptSubmit": "user_prompt_submit",
    "SubagentStart": "subagent_start",
    "SubagentStop": "subagent_stop",
    "Stop": "stop",
    "Interrupt": "interrupt",
}


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")


def dotfiles_dir() -> Path:
    return Path(__file__).resolve().parent.parent


def load(path: Path) -> dict[str, Any]:
    with path.open("rb") as fh:
        return tomllib.load(fh)


def key(k: str) -> str:
    return k if BARE_KEY.match(k) else json.dumps(k, ensure_ascii=False)


def scalar(v: Any) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        if math.isnan(v):
            return "nan"
        if v in (float("inf"), float("-inf")):
            return "inf" if v > 0 else "-inf"
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, (dt.datetime, dt.date, dt.time)):
        return v.isoformat()
    if isinstance(v, list):
        return "[" + ", ".join(scalar(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{key(k)} = {scalar(x)}" for k, x in v.items()) + " }"
    raise TypeError(f"cannot emit {type(v).__name__} as TOML")


def is_table(v: Any) -> bool:
    return isinstance(v, dict)


def is_table_array(v: Any) -> bool:
    return isinstance(v, list) and bool(v) and all(isinstance(x, dict) for x in v)


def emit_table(path: list[str], table: dict[str, Any], out: list[str]) -> None:
    for k, v in table.items():
        if not is_table(v) and not is_table_array(v):
            out.append(f"{key(k)} = {scalar(v)}")
    for k, v in table.items():
        sub = [*path, k]
        header = ".".join(key(p) for p in sub)
        if is_table(v):
            out.append("")
            out.append(f"[{header}]")
            emit_table(sub, v, out)
        elif is_table_array(v):
            for item in v:
                out.append("")
                out.append(f"[[{header}]]")
                emit_table(sub, item, out)


def render(data: dict[str, Any]) -> str:
    out: list[str] = []
    emit_table([], data, out)
    text = "\n".join(out).lstrip("\n") + "\n"
    if tomllib.loads(text) != data:
        raise ValueError("rendered TOML does not parse back to the same data; refusing to write")
    return text


def owned_units(tracked: dict[str, Any]) -> list[tuple[str, ...]]:
    units: list[tuple[str, ...]] = []
    for k, v in tracked.items():
        if is_table(v):
            units.extend((k, k2) for k2 in v)
        else:
            units.append((k,))
    return units


def get(data: dict[str, Any], path: tuple[str, ...]) -> Any:
    cur: Any = data
    for p in path:
        if not isinstance(cur, dict) or p not in cur:
            return _MISSING
        cur = cur[p]
    return cur


_MISSING = object()


def leaves(v: Any, prefix: str = "") -> dict[str, Any]:
    if isinstance(v, dict):
        found: dict[str, Any] = {}
        for k, x in v.items():
            found.update(leaves(x, f"{prefix}.{key(k)}" if prefix else key(k)))
        return found
    return {prefix: v}


def drift(tracked: dict[str, Any], live: dict[str, Any]) -> list[str]:
    lines: list[str] = []
    for unit in owned_units(tracked):
        want = get(tracked, unit)
        have = get(live, unit)
        if want == have:
            continue
        name = ".".join(key(p) for p in unit)
        if have is _MISSING:
            lines.append(f"{name}: missing from live, tracked={scalar(want) if not is_table(want) else '(table)'}")
            continue
        w, h = leaves(want, name), leaves(have, name)
        for k in sorted(set(w) | set(h)):
            if w.get(k, _MISSING) != h.get(k, _MISSING):
                ws = scalar(w[k]) if k in w else "(absent)"
                hs = scalar(h[k]) if k in h else "(absent)"
                lines.append(f"{k}: tracked={ws} live={hs}")
    return lines


def merge(tracked: dict[str, Any], live: dict[str, Any]) -> dict[str, Any]:
    result = _deepcopy(live)
    for unit in owned_units(tracked):
        cur = result
        for p in unit[:-1]:
            if not is_table(cur.get(p)):
                cur[p] = {}
            cur = cur[p]
        cur[unit[-1]] = _deepcopy(get(tracked, unit))
    return result


def _deepcopy(v: Any) -> Any:
    if isinstance(v, dict):
        return {k: _deepcopy(x) for k, x in v.items()}
    if isinstance(v, list):
        return [_deepcopy(x) for x in v]
    return v


def check_tracked(tracked: dict[str, Any]) -> None:
    for path in FORBIDDEN_IN_TRACKED:
        if get(tracked, path) is not _MISSING:
            print(f"codex-config: tracked config must not contain [{'.'.join(path)}]; Codex owns it", file=sys.stderr)
            raise SystemExit(2)


def hooks_trust(live: dict[str, Any], hooks_path: Path) -> list[str]:
    """Trust is recorded per handler under hooks.state, keyed
    "<hooks.json path>:<event label>:<group index>:<handler index>"."""
    if not hooks_path.exists():
        return []
    with hooks_path.open("rb") as fh:
        manifest = json.load(fh)
    state = get(live, ("hooks", "state"))
    state = state if isinstance(state, dict) else {}
    missing: list[str] = []
    for event, groups in manifest.get("hooks", {}).items():
        label = EVENT_LABEL.get(event, event)
        for g, group in enumerate(groups):
            for h, handler in enumerate(group.get("hooks", [])):
                k = f"{hooks_path}:{label}:{g}:{h}"
                if not (state.get(k) or {}).get("trusted_hash"):
                    missing.append(f"{event}[{g}][{h}] {handler.get('command', '?')}")
    return missing


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = ap.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--apply", action="store_true")
    mode.add_argument("--render", action="store_true")
    mode.add_argument("--hooks-trust", action="store_true")
    ap.add_argument("--live", type=Path, default=codex_home() / "config.toml")
    ap.add_argument("--tracked", type=Path, default=dotfiles_dir() / ".codex" / "config.toml")
    ap.add_argument("--hooks", type=Path, default=codex_home() / "hooks.json")
    ap.add_argument("--backup-dir", type=Path, default=None)
    args = ap.parse_args()

    live = load(args.live) if args.live.exists() else {}

    if args.hooks_trust:
        missing = hooks_trust(live, args.hooks)
        for m in missing:
            print(m)
        return 1 if missing else 0

    tracked = load(args.tracked)
    check_tracked(tracked)

    if args.check:
        lines = drift(tracked, live)
        for line in lines:
            print(line)
        return 1 if lines else 0

    merged = merge(tracked, live)
    text = render(merged)
    if args.render:
        sys.stdout.write(text)
        return 0

    if args.live.exists() and args.live.read_text() == text:
        return 0
    if args.live.exists():
        stamp = dt.datetime.now(tz=dt.UTC).astimezone().strftime("%Y%m%d-%H%M%S")
        backup_dir = args.backup_dir or Path.home() / ".dotfiles-backup" / stamp
        dest = backup_dir / ".codex" / "config.toml"
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(args.live, dest)
        print(f"  backed up to {dest}")
    tmp = args.live.with_suffix(".toml.tmp")
    tmp.write_text(text)
    os.replace(tmp, args.live)
    return 0


if __name__ == "__main__":
    sys.exit(main())
