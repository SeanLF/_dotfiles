#!/bin/bash
# Record that a reviewer agent has seen the current tree and HEAD, for bin/review-gate.
#
# Wired to SubagentStop, not PostToolUse(Task): a backgrounded Agent call
# returns at spawn, so PostToolUse would record before the reviewer read a file.
# Records that a reviewer RAN, not that it approved.
set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0

INPUT=$(cat)
AGENT=$(printf '%s' "$INPUT" | jq -r '.tool_input.subagent_type // .agent_type // empty' 2>/dev/null)
EVENT=$(printf '%s' "$INPUT" | jq -r '.hook_event_name // "?"' 2>/dev/null)
CWD=$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)

case "$AGENT" in
  feature-dev:code-reviewer | \
    pr-review-toolkit:code-reviewer | \
    pr-review-toolkit:code-simplifier | \
    pr-review-toolkit:silent-failure-hunter | \
    code-simplifier:code-simplifier | \
    adversarial-reviewer | \
    reviewer) ;;
  *) exit 0 ;;
esac

if [ -n "$CWD" ] && ! cd "$CWD" 2>/dev/null; then
  exit 0
fi

# Not named GIT_DIR: git exports that into hooks inside a linked worktree.
COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
# Pending is per worktree (review-gate reads it from --git-dir).
PRIVATE_DIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0

# Stamp the whole unpushed range, not just HEAD: the range hash below already
# certifies it, but a follow-up commit changes that hash and would orphan the
# commits under HEAD.
if HEAD_SHA=$(git rev-parse -q --verify HEAD 2>/dev/null); then
  {
    "$(dirname "$0")/review-gate" --range
    echo "$HEAD_SHA"
  } >>"$COMMON_DIR/claude-reviewed-commits"
  [ "$(cat "$PRIVATE_DIR/claude-pending-review" 2>/dev/null)" = "$HEAD_SHA" ] &&
    rm -f "$PRIVATE_DIR/claude-pending-review"
fi

HASHES=$("$(dirname "$0")/review-gate" --hash) || exit 0

# A clean, pushed tree hashes empty everywhere; recording that would certify nothing.
EMPTY=$(printf '' | shasum -a 256 | cut -c1-16)
printf '%s\n' "$HASHES" | grep -qv "=${EMPTY}\$" || exit 0

if ! printf '%s\nagent=%s\nevent=%s\n' "$HASHES" "$AGENT" "$EVENT" \
  >"$COMMON_DIR/claude-review" 2>/dev/null; then
  echo "record-review: cannot write $COMMON_DIR/claude-review; the push will be gated" >&2
fi
