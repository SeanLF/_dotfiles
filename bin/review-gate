#!/bin/bash
# Review gate for agent commits: a speed bump for an honest agent, not a boundary.
# Keys on CLAUDECODE=1 (Claude Code) or CODEX_THREAD_ID (Codex).
#
#   review-gate --pending              exit 1 while HEAD is an unreviewed agent commit
#   review-gate --stop                 Stop hook: block ending the turn once per such commit
#   review-gate --push LOCAL REMOTE    exit 1 unless every commit in the push is stamped
#   review-gate --range                print the unpushed commits (record-review stamps these)
#
# State: claude-reviewed-commits and claude-review-force in the common git dir;
# claude-pending-review and claude-stop-nudged per worktree.
set -uo pipefail

# Never name a variable GIT_DIR: git exports it into hooks inside a linked
# worktree, and assigning it repoints every later git call.

agent_session() { [ "${CLAUDECODE:-}" = "1" ] || [ -n "${CODEX_THREAD_ID:-}" ]; }

range_base() { # $1 = local commit, $2 = remote sha or empty
  local up b
  if [ -n "${2:-}" ]; then
    git merge-base "$2" "$1" 2>/dev/null && return
  fi
  if up=$(git rev-parse -q --verify '@{upstream}' 2>/dev/null); then
    git merge-base "$up" "$1" 2>/dev/null && return
  fi
  # Remote-tracking refs only: a local main IS the branch being pushed.
  for b in origin/HEAD origin/main origin/master; do
    git merge-base "$b" "$1" 2>/dev/null && return
  done
  git hash-object -t tree /dev/null
}

# A forked /code-review reports agent_type general-purpose; its task description
# is the only thing that says it is a review.
is_reviewer() { # $1 = agent_type, $2 = task description
  case "$1" in
    feature-dev:code-reviewer | pr-review-toolkit:code-reviewer | pr-review-toolkit:code-simplifier | \
      pr-review-toolkit:silent-failure-hunter | code-simplifier:code-simplifier | adversarial-reviewer | reviewer)
      return 0
      ;;
    general-purpose) case "${2:-}" in /code-review*) return 0 ;; esac ;;
  esac
  return 1
}

if [ "${1:-}" = "--reviewer" ]; then
  is_reviewer "${2:-}" "${3:-}"
  exit $?
fi

if [ "${1:-}" = "--range" ]; then
  head=$(git rev-parse -q --verify HEAD 2>/dev/null) || exit 0
  git rev-list "$(range_base "$head")..$head" 2>/dev/null
  exit 0
fi

# stop_hook_active: the model was already sent back once; blocking again loops.
if [ "${1:-}" = "--stop" ]; then
  command -v jq >/dev/null 2>&1 || exit 0
  input=$(cat)
  [ "$(printf '%s' "$input" | jq -r '.stop_hook_active // false' 2>/dev/null)" = "true" ] && exit 0
  cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
  if [ -n "$cwd" ]; then cd "$cwd" 2>/dev/null || exit 0; fi
fi

COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
COMMON_DIR=$(cd "$COMMON_DIR" && pwd) || exit 0
PRIVATE_DIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0

if [ -n "$(git rev-parse --show-superproject-working-tree 2>/dev/null)" ]; then
  echo "review-gate: submodule, not gated (the review record lives in the superproject)." >&2
  exit 0
fi

STAMPS="$COMMON_DIR/claude-reviewed-commits"
PENDING="$PRIVATE_DIR/claude-pending-review"
NUDGED="$PRIVATE_DIR/claude-stop-nudged"
FORCE="$COMMON_DIR/claude-review-force"
stamped() { grep -qx "$1" "$STAMPS" 2>/dev/null; }

reviewers() {
  cat <<'EOF'
Running any ONE of these clears the gate (agents by exact subagent_type):
  /code-review medium                       <- the default: Skill tool, skill "code-review"
  feature-dev:code-reviewer                 <- Sonnet, read-only
  pr-review-toolkit:code-reviewer
  pr-review-toolkit:code-simplifier
  pr-review-toolkit:silent-failure-hunter   <- if error handling changed
  code-simplifier:code-simplifier
  adversarial-reviewer                      <- Opus; before a push, not every turn
  reviewer                                  <- Codex: spawn_agent with agent_type "reviewer"

EOF
}

if [ "${1:-}" = "--pending" ] || [ "${1:-}" = "--stop" ]; then
  head=$(git rev-parse -q --verify HEAD 2>/dev/null) || exit 0
  [ "$(cat "$PENDING" 2>/dev/null)" = "$head" ] || exit 0
  if [ -f "$FORCE" ]; then
    rm -f "$FORCE" "$PENDING"
    echo "$head" >>"$STAMPS"
    exit 0
  fi
  if [ "$1" = "--stop" ]; then
    # A reviewer already running will stamp the commit when it finishes.
    while IFS=$'\t' read -r t d; do
      is_reviewer "$t" "$d" && exit 0
    done < <(printf '%s' "$input" | jq -r '.background_tasks[]? | select(.status == "running") | [.agent_type // "", .description // ""] | @tsv' 2>/dev/null)
    [ "$(cat "$NUDGED" 2>/dev/null)" = "$head" ] && exit 0
    echo "$head" >"$NUDGED"
  fi
  msg=$(
    printf 'Review gate. Commit %s has not been reviewed. Before finishing, run one reviewer over the unpushed commits:\n\n' "${head:0:7}"
    printf '  git log -p %s..%s\n\n' "$(range_base "$head" | cut -c1-7)" "${head:0:7}"
    reviewers
    printf 'Address what it finds in new commits. For a trivial or purely mechanical commit instead:\n\n  touch %s\n' "$FORCE"
  )
  if [ "$1" = "--stop" ]; then
    jq -cn --arg r "$msg" '{decision: "block", reason: $r}'
    exit 0
  fi
  printf '%s\n' "$msg" >&2
  exit 1
fi

if [ "${1:-}" = "--push" ]; then
  agent_session || exit 0
  local_sha="${2:-}"
  remote_sha="${3:-}"
  case "$remote_sha" in *[!0]*) ;; *) remote_sha="" ;; esac # all zeros: new ref
  [ -n "$local_sha" ] || exit 0

  # Consumed here: there is no post-push hook to clear it.
  if [ -f "$FORCE" ]; then
    rm -f "$FORCE"
    exit 0
  fi

  base=$(range_base "$local_sha" "$remote_sha")
  unstamped=""
  for c in $(git rev-list "$base..$local_sha" 2>/dev/null); do
    stamped "$c" || unstamped="$unstamped ${c:0:7}"
  done
  [ -z "$unstamped" ] && exit 0

  {
    printf '\nReview gate. Unreviewed commits in this push:%s (%s..%s).\n' \
      "$unstamped" "${base:0:7}" "${local_sha:0:7}"
    printf 'Run one reviewer over the whole range.\n\n'
    reviewers
    printf 'To skip a trivial or purely mechanical change, run this, then push again:\n\n  touch %s\n' "$FORCE"
  } >&2
  exit 1
fi
