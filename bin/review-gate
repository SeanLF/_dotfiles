#!/bin/bash
# Refuse a Claude-made commit whose content has not been through a reviewer agent.
#
# Called from the global pre-commit hook, AFTER lefthook, so the content it hashes
# is the content that will actually land. The PreToolUse version of this gate ran
# before its own tool call, which is before git, which is before lefthook: it
# certified the pre-formatter tree and then lost its marker whenever a formatter
# rewrote a file and aborted the commit.
#
# The gate is a content hash, not a one-shot marker. A review is valid exactly as
# long as the tree it reviewed is the tree being committed, so a failed commit
# costs nothing and there is no marker to re-arm.
#
# This is a speed bump for an honest agent, not a boundary. It is keyed on
# CLAUDECODE, which the model can unset; hook-bypass-guard.sh denies the known
# forms of that at the tool boundary, but the PreToolUse gate this replaces was
# the only version the model could not talk its way around. That is the price of
# exact detection, paid deliberately.
#
#   review-gate            gate a commit (exit 1 to refuse)
#   review-gate --hash     print both content hashes, for bin/record-review
set -uo pipefail

# NEVER name a variable GIT_DIR here. Inside a linked worktree git exports
# GIT_DIR into its hooks, so assigning that name silently repoints every later
# git call at whatever you put in it, including the diff below. That made a
# reviewed worktree commit impossible to clear by reviewing: the gate hashed one
# worktree and record-review hashed another, and the mismatch message blamed a
# formatter and told you to re-review, which could never work.

# Before the first commit there is no HEAD, and `git diff HEAD` fatals while
# still yielding the digest of empty input, so every tree in a fresh repo hashes
# alike and any review certifies any initial commit. Diff against the empty tree
# instead; git knows that OID even in an empty object store.
diff_base() {
  git rev-parse -q --verify HEAD 2>/dev/null ||
    git hash-object -t tree /dev/null
}
digest() { shasum -a 256 | cut -c1-16; }

# Two hashes, because the reviewer and the commit look at different things.
#
# The gate hashes the STAGED diff, because that is what actually lands. Hashing
# the worktree instead left it blind to a path staged and then restored in the
# worktree: the diff read clean while the staged change still committed.
#
# record-review stores both, because a reviewer usually reads the working diff
# before anything is staged. The gate passes if what lands matches EITHER, which
# keeps a pre-staging review valid through `git add` without letting staged
# content the reviewer never saw through.
#
# --no-prefix is load-bearing, not cosmetic. This machine sets
# diff.mnemonicPrefix, which labels the diff by comparison type: `git diff`
# emits `w/` for the worktree and `--cached` emits `i/` for the index. Identical
# content therefore hashed differently on the two sides, so the worktree branch
# was dead code and every review taken before `git add` demanded a second one.
# --no-prefix also immunizes both against diff.noprefix and diff.srcPrefix.
worktree_hash() { git diff --no-prefix "$(diff_base)" 2>/dev/null | digest; }
staged_hash() { git diff --no-prefix --cached "$(diff_base)" 2>/dev/null | digest; }

# sha256 of empty input. A reviewer most often finishes just after a commit
# lands, when the tree is clean by construction, and recording that digest would
# certify "nothing" and then match any commit that stages nothing.
EMPTY_DIGEST=$(printf '' | digest)

if [ "${1:-}" = "--hash" ]; then
  printf 'worktree=%s\nstaged=%s\n' "$(worktree_hash)" "$(staged_hash)"
  exit 0
fi

[ "${CLAUDECODE:-}" = "1" ] || exit 0

# --git-common-dir so a linked worktree and the main tree agree on where the
# record lives; --git-dir for in-progress state, which is per-worktree.
COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
COMMON_DIR=$(cd "$COMMON_DIR" && pwd) || exit 0
PRIVATE_DIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0

# git replays existing commits during these; the review happened for the original.
for state in CHERRY_PICK_HEAD REVERT_HEAD MERGE_HEAD rebase-merge rebase-apply; do
  [ -e "$PRIVATE_DIR/$state" ] && exit 0
done

# A submodule commit runs here with its own git dir while record-review resolved
# the superproject's, so no review could ever clear it and the hatch would be the
# only way through, on every commit. Announce rather than skip in silence.
if [ -n "$(git rev-parse --show-superproject-working-tree 2>/dev/null)" ]; then
  echo "review-gate: submodule commit, not gated (the review record lives in the superproject)." >&2
  exit 0
fi

ARTIFACT="$COMMON_DIR/claude-review"
FORCE="$COMMON_DIR/claude-review-force"

# Tested, never consumed. commit-msg runs after pre-commit, so consuming here
# means a message check-commit-msg rejects destroys the hatch and leaves no way
# through: exactly the failure this gate exists to remove, one hook later.
# git/hooks/post-commit clears it, once the commit has actually landed.
[ -f "$FORCE" ] && exit 0

# What actually lands.
current=$(staged_hash)

# Nothing staged means nothing lands: a reword-only `--amend`, an
# `--allow-empty`, or a commit git is about to reject on its own. There is no
# content to review, and denying wedged the reword case with advice ("stage the
# change first") that could never be followed. --amend is gated separately by
# commit-guard.sh, which knows something git cannot: whether I asked for it.
[ "$current" = "$EMPTY_DIGEST" ] && exit 0

reviewed_worktree=$(sed -n 's/^worktree=//p' "$ARTIFACT" 2>/dev/null)
reviewed_staged=$(sed -n 's/^staged=//p' "$ARTIFACT" 2>/dev/null)

if [ "$current" = "$reviewed_worktree" ] || [ "$current" = "$reviewed_staged" ]; then
  exit 0
fi

reviewed="$reviewed_worktree"
if [ -n "$reviewed" ]; then
  why="A review exists but it covered different content (reviewed ${reviewed}, committing ${current}).
Something changed the tree after the review, most likely a formatter in lefthook.
Re-run a reviewer so the review covers what actually lands."
else
  why="No reviewer agent has seen this tree. $(git diff --cached --name-only | wc -l | tr -d ' ') file(s) staged."
fi

cat >&2 <<EOF

Review gate. ${why}

Running any ONE of these clears the gate (exact subagent_type, the prefix matters):
  pr-review-toolkit:code-reviewer
  pr-review-toolkit:code-simplifier
  pr-review-toolkit:silent-failure-hunter   <- if error handling changed
  code-simplifier:code-simplifier
  feature-dev:code-reviewer
  adversarial-reviewer                      <- refutes rather than confirms; worth running last

To skip a trivial or purely mechanical change, run this, then retry the commit:

  touch ${FORCE}

A failed commit costs nothing here: the review stays valid until the content
changes, and the hatch survives until a commit actually lands.
EOF
exit 1
