#!/bin/bash
# System maintenance — run periodically to keep packages updated.
# Pass --check to preview what *would* be upgraded without changing anything.
set -e

CHECK_ONLY=false
for arg in "$@"; do
  case "$arg" in
    --check | -n) CHECK_ONLY=true ;;
    -h | --help)
      echo "Usage: $0 [--check]"
      exit 0
      ;;
    *)
      echo "unknown argument: $arg" >&2
      echo "Usage: $0 [--check]" >&2
      exit 2
      ;;
  esac
done

# Activate mise so tools it manages (tldr, gh, etc.) are on PATH for this script.
# Maintenance runs non-interactively, so mise's shell prompt hooks don't fire;
# `mise env` emits the equivalent exports directly. Guarded so a mise hiccup
# doesn't abort the whole run under `set -e`.
if command -v mise &>/dev/null; then
  eval "$(mise env -s bash 2>/dev/null)" || true
fi

if [[ -t 1 ]]; then
  bold='\033[1m' dim='\033[2m'
  red='\033[31m' green='\033[32m' yellow='\033[33m' blue='\033[34m'
  reset='\033[0m'
else
  bold='' dim='' red='' green='' yellow='' blue='' reset=''
fi

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BREWFILE="$DOTFILES_DIR/Brewfile"
RUBY_GEMS="$DOTFILES_DIR/ruby-global-gems"
failures=()

step_started=""
step_done() {
  [[ -n "$step_started" ]] || return 0
  info "($((SECONDS - step_started))s)"
}
step() {
  step_done
  step_started=$SECONDS
  echo -e "${bold}${blue}==> $1${reset}"
}
info() { echo -e "${dim}$1${reset}"; }
ok() { echo -e "${green}$1${reset}"; }
warn() {
  echo -e "${yellow}$1${reset}" >&2
  failures+=("$1")
}

# Run a command and convert non-zero exit into a warning (not a hard fail).
# Individual step failures shouldn't abort the whole maintenance run.
try() { "$@" || warn "$* failed"; }

# Snapshot resolved tool versions BEFORE any upgrade, so a bad `mise upgrade`
# (or uv/rustup bump) is recoverable — those managers are version-addressable
# (`mise install ruby@<old>`). Brew has no clean downgrade, so its list is
# reference-only. Config rollback is already covered by git (Brewfile, mise config).
step_snapshot() {
  step "Version snapshot"
  if $CHECK_ONLY; then
    info "(skipped in --check mode — nothing to protect)"
    return
  fi
  local versions_dir="$HOME/.dotfiles-backup/versions" out old
  out="$versions_dir/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$out" || {
    warn "could not create snapshot dir $out"
    return
  }
  mise ls >"$out/mise.txt" 2>/dev/null || true
  command -v uv &>/dev/null && uv tool list >"$out/uv-tools.txt" 2>/dev/null || true
  command -v rustup &>/dev/null && rustup toolchain list >"$out/rustup.txt" 2>/dev/null || true
  brew list --versions >"$out/brew.txt" 2>/dev/null || true
  # mise is the primary version-addressable manager (the main rollback target),
  # so an empty manifest means the rollback point is unusable — say so loudly.
  if [[ -s "$out/mise.txt" ]]; then
    ok "snapshot -> $out"
  else
    warn "snapshot: mise.txt is empty — rollback point may be unusable ($out)"
  fi
  # Keep the newest 30 rollback points (about a month of daily runs).
  while IFS= read -r old; do
    rm -r "$old" || warn "snapshot: could not prune $old"
  done < <(find "$versions_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r | tail -n +31)
}

step_homebrew() {
  step "Homebrew"
  try brew update

  # Brew redoing a self-updating cask reinstalls what the app already moved past.
  export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1

  if $CHECK_ONLY; then
    brew outdated || true
    brew outdated --cask --greedy-auto-updates || true
  else
    # Homebrew made "ask mode" the default for `brew upgrade`, so it prompts
    # "Do you want to proceed? [y/n]" whenever a TTY is attached (i.e. when run
    # by hand). --no-ask restores unattended behaviour. https://github.com/Homebrew/brew/issues/22597
    try brew upgrade --no-ask
    try brew upgrade --cask --no-ask
    try brew autoremove
    try brew cleanup
  fi
}

step_appstore() {
  step "App Store"
  if $CHECK_ONLY; then
    mas outdated || true
  else
    try mas upgrade
  fi
}

# Xcode prereleases (xcodes). Stable is the App Store copy and mas upgrades it;
# here it is report-only. Prereleases churn fast, so if you already run one we
# auto-upgrade it to the latest.
# `xcodes list` prints ascending and marks installed versions "(Installed)", so
# the last "Beta" or "Release Candidate" line is the newest prerelease and tells
# us if we're already on it (cheap guard against a needless multi-GB re-download).
# RCs are prereleases too: `--latest-prerelease` installs them, so the parse and
# the installed gate must both match them or the RC is invisible.
step_xcodes() {
  step "Xcode (xcodes)"
  command -v xcodes &>/dev/null || {
    info "xcodes not installed, skipping"
    return
  }
  # `xcodes update` refreshes the cached list but prints all ~285 versions;
  # silence it since we re-read what we need from `xcodes list` below.
  xcodes update >/dev/null 2>&1 || warn "xcodes update failed"

  # Anchor on lines starting with a version number to skip blank lines and the
  # "Showing Xcodes for this Mac..." footer that `xcodes list` prints. Read once.
  local list prerelease_re latest_pre latest_stable
  prerelease_re="beta|release candidate"
  list=$(xcodes list 2>/dev/null)
  latest_pre=$(echo "$list" | grep -iE "^[0-9].*($prerelease_re)" | tail -1)
  latest_stable=$(echo "$list" | grep -E "^[0-9]" | grep -viE "$prerelease_re" | tail -1)

  # Auto-upgrade the prerelease only if one is installed and it isn't already newest.
  # Multi-GB download; may prompt for your Apple ID if xcodes has no cached
  # session. --latest-prerelease self-updates the list before installing. Guard
  # the empty-parse case so a format drift can't blank the "already newest"
  # check and trigger a needless re-download.
  if [[ -z "$latest_pre" ]]; then
    warn "xcodes: could not parse a prerelease from 'xcodes list' (format change?)"
  elif xcodes installed 2>/dev/null | grep -qiE "$prerelease_re"; then
    if echo "$latest_pre" | grep -qi "installed"; then
      info "on latest prerelease: $latest_pre"
    elif $CHECK_ONLY; then
      info "newer prerelease available — would install: $latest_pre"
    elif [[ -t 0 ]]; then
      info "upgrading to latest prerelease: $latest_pre"
      try xcodes install --latest-prerelease
    else
      # xcodes needs interactive Apple ID 2FA; a headless run can't answer it,
      # so report instead of failing on every unattended sweep.
      info "newer prerelease available (run maintenance interactively — needs Apple ID 2FA): $latest_pre"
    fi
  fi

  if [[ -z "$latest_stable" ]]; then
    :
  elif echo "$latest_stable" | grep -qi "installed"; then
    info "on latest stable: $latest_stable"
  else
    info "latest stable available (install manually): $latest_stable"
  fi
}

# Workaround: `claude update` downloads the full binary (~200MB) even when
# already up-to-date. Compare versions first to skip the download.
# Claude Code also auto-upgrades while running; this just prefetches before
# the next session starts. https://github.com/anthropics/claude-code/issues/20808
step_claude_code() {
  step "Claude Code"
  local local_ver dist_url remote_ver
  local_ver="$(claude --version 2>/dev/null | awk '{print $1}' || true)"
  dist_url="$(curl -sI https://claude.ai/install.sh 2>/dev/null |
    grep -i '^location:' | tr -d '\r' |
    sed 's/^[Ll]ocation: //; s|/bootstrap\.sh$||')"
  remote_ver="$(curl -sf "$dist_url/latest" 2>/dev/null || true)"

  if [[ -z "$remote_ver" ]]; then
    warn "could not check latest Claude Code version, skipping"
  elif [[ "$local_ver" == "$remote_ver" ]]; then
    ok "Claude Code is already up to date ($local_ver)"
  else
    info "Claude Code $local_ver -> $remote_ver"
    $CHECK_ONLY || try claude update
  fi
}

# Claude plugins/skills self-update, but refreshing here stages the latest
# versions before the next session so you don't run the reload slash command
# mid-session. Refresh all marketplace sources, then update each enabled plugin
# (there is no `update --all`; "restart required to apply").
step_claude_plugins() {
  step "Claude plugins/skills"
  command -v claude &>/dev/null || {
    info "claude not found, skipping"
    return
  }
  try claude plugin marketplace update
  if $CHECK_ONLY; then
    info "(check mode: marketplace refreshed; plugin updates skipped)"
    return
  fi
  command -v jq &>/dev/null || {
    warn "jq not found — skipping per-plugin updates"
    return
  }
  # Distinguish "list failed / schema drifted" from "genuinely zero enabled
  # plugins" — otherwise a broken CLI silently reads as nothing-to-do and
  # plugins go stale unnoticed.
  local raw ids id
  if ! raw=$(claude plugin list --json 2>/dev/null); then
    warn "claude plugin list failed"
    return
  fi
  # Use the full "name@marketplace" id — `claude plugin update` resolves that,
  # not the bare name. A plugin enabled at both user and project scope is listed
  # once per scope; the update is per id, so dedupe or it runs twice.
  ids=$(jq -r '[.[] | select(.enabled) | .id] | unique[]' <<<"$raw" 2>/dev/null) || {
    warn "could not parse plugin list (format change?)"
    return
  }
  if [[ -z "$ids" ]]; then
    info "no enabled plugins to update"
    return
  fi
  while IFS= read -r id; do
    [[ -n "$id" ]] && try claude plugin update "$id"
  done <<<"$ids"
}

# agy self-updates in the background on every invocation (per upstream install
# script), and `agy update` re-fetches the full ~42MB tarball even when current.
# Skip it here.

step_mise() {
  step "mise"
  # Scope GITHUB_TOKEN to just this step so it doesn't leak to other tools.
  # Without it, mise's "latest" resolution hits unauthenticated rate limits.
  local gh_token=""
  if command -v gh &>/dev/null && gh auth status &>/dev/null; then
    gh_token="$(gh auth token)"
  fi
  if $CHECK_ONLY; then
    GITHUB_TOKEN="$gh_token" mise outdated || true
    return
  fi
  # mise exits 0 when it cannot resolve a tool's latest version (rate limit,
  # flaky GitHub API) and then reports "all up to date"; that tool was silently
  # skipped. Its warnings go to stderr, so capture that and surface them.
  local log
  log=$(mktemp)
  GITHUB_TOKEN="$gh_token" mise upgrade 2>"$log" || warn "mise upgrade failed"
  cat "$log" >&2
  if grep -qE "Error getting latest version|Remote versions cannot be fetched" "$log"; then
    warn "mise: could not resolve the latest version of some tools; they were not upgraded"
  fi
  rm -f "$log"
  try mise prune --yes
}

# `mise prune` only removes orphaned versions tracked via configs; tools
# installed with no config source linger silently. `mise ls` renders the
# source config as the 3rd column, so any row with fewer than 3 columns
# is an undeclared install — unless another project's config declares it.
# `mise ls` only resolves sources from the configs active in the cwd, but
# mise keeps symlinks to every config it has seen in its state dir.
step_mise_drift() {
  step "mise drift"
  local tracked drift="" name ver
  tracked=$(cat "$HOME/.local/state/mise/tracked-configs"/* 2>/dev/null) || true
  while read -r name ver _; do
    [[ -n "$name" ]] || continue
    grep -qF "$name" <<<"$tracked" || drift+="  - $name $ver"$'\n'
  done < <(mise ls 2>/dev/null | awk 'NF>0 && NF<3')
  if [[ -z "$drift" ]]; then
    ok "all mise installs declared"
  else
    warn "untracked mise installs (declare in config or uninstall):"
    printf '%s' "$drift" >&2
  fi
}

step_uv() {
  step "uv tools"
  if $CHECK_ONLY; then
    uv tool list --outdated 2>/dev/null || uv tool list || true
  else
    try uv tool upgrade --all
  fi
}

# Default gems shipped with mise-managed Ruby drift behind upstream and
# aren't refreshed by `mise upgrade`.
#
# Gems with native extensions (openssl, etc.) need to find brew's OpenSSL
# headers at build time. mise's Ruby doesn't ship pkg-config metadata for
# its vendored openssl, so without these env vars `gem update openssl`
# fails with "OpenSSL library could not be found". Passing --with-openssl-dir
# after `--` forwards it to every gem's extconf.rb; gems that don't care
# ignore unknown flags.
step_gems() {
  step "Ruby gems"
  command -v gem &>/dev/null || {
    info "gem not found, skipping"
    return
  }

  # Bare-metal tool gems that must live in the Ruby gemset (see ruby-global-gems).
  # mise gives each Ruby its own gemset, so a new Ruby starts empty and these
  # need (re)installing; project gems come from each repo's bundle, not here.
  local wanted=() line
  if [[ -f "$RUBY_GEMS" ]]; then
    while IFS= read -r line; do
      line="${line%%#*}"           # strip inline comments
      line="${line//[[:space:]]/}" # drop all whitespace
      [[ -n "$line" ]] && wanted+=("$line")
    done <"$RUBY_GEMS"
  fi

  if $CHECK_ONLY; then
    if ((${#wanted[@]})); then
      local installed missing=() g
      installed="$(gem list --no-versions || true)"
      for g in "${wanted[@]}"; do
        grep -qxF "$g" <<<"$installed" || missing+=("$g")
      done
      ((${#missing[@]})) && info "would install (missing host gems): ${missing[*]}"
    fi
    gem outdated || true
    return
  fi

  # `local -x` scopes the openssl export to the gem child processes and restores
  # the prior env on return, so nothing leaks into later maintenance steps.
  local openssl_prefix="" ssl_args=()
  if command -v brew &>/dev/null; then
    openssl_prefix="$(brew --prefix openssl@3 2>/dev/null || true)"
  fi
  if [[ -n "$openssl_prefix" ]]; then
    local -x PKG_CONFIG_PATH="$openssl_prefix/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    ssl_args=(-- --with-openssl-dir="$openssl_prefix")
  fi

  ((${#wanted[@]})) && try gem install --no-document --conservative "${wanted[@]}" "${ssl_args[@]}"
  try gem update "${ssl_args[@]}"
  try gem cleanup
}

# rustup is bootstrapped manually (not via brew or mise). mise's `rust` plugin
# delegates to rustup, so `mise upgrade` installs the latest stable toolchain
# through rustup, but rustup itself, its other toolchains, and stale
# components only refresh via `rustup self update` / `rustup update`.
step_rustup() {
  step "rustup"
  command -v rustup &>/dev/null || {
    info "rustup not installed, skipping"
    return
  }
  if $CHECK_ONLY; then
    rustup check || true
  else
    try rustup self update
    try rustup update
  fi
}

step_tldr() {
  step "tldr"
  $CHECK_ONLY || try tldr --update
}

step_brewfile() {
  step "Brewfile"
  if $CHECK_ONLY; then
    info "(skipped in --check mode)"
  elif [[ -f "$BREWFILE" ]]; then
    # --describe is deprecated; descriptions are included by default now
    try brew bundle dump --file="$BREWFILE" --force
    ok "Brewfile updated"
  else
    warn "Brewfile not found at $BREWFILE"
  fi
}

step_macos() {
  step "macOS updates"
  softwareupdate --list 2>&1 | grep -vE "^Software Update Tool|^Finding available software|^$" || true
}

# Bail early if offline
if ! online -q 5; then
  echo -e "${red}No network connectivity — skipping maintenance${reset}"
  exit 1
fi

step_snapshot
step_homebrew
step_appstore
step_xcodes
step_claude_code
step_claude_plugins
step_mise
step_mise_drift
step_gems
step_rustup
step_uv
step_tldr
step_brewfile
step_macos
step_done

echo ""
if [[ ${#failures[@]} -gt 0 ]]; then
  echo -e "${red}Finished with ${#failures[@]} warning(s):${reset}"
  for f in "${failures[@]}"; do echo -e "  ${yellow}- $f${reset}"; done
  exit 1
else
  ok "Done -- all clear!"
fi
