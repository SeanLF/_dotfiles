#!/bin/bash
# Claude Code on NVIDIA NIM (free hosted models) via the Olla proxy
#
# Usage: ccnim [-m MODEL] [--restart] [-h] [claude args...]
#   -m, --model     kimi (default) | flash | pro | nemotron | <NIM model id>
#       --restart   Restart the Olla proxy first (use after editing its config)
#   -h, --help      Show this help message
#
# Runs Claude Code CLI against a free NIM model through Olla, a local
# Anthropic<->OpenAI proxy. The NIM key is read from 1Password at runtime and
# never stored. -m switches both the main agent and subagents, with no restart:
# every model tier is pointed at the chosen id, so Olla only ever sees that one
# name. Olla auto-starts on :40114 if not running.
# For offline/confidential or heavy parallel work use `ccl` (local llama.cpp).

set -e

show_help() {
  sed -n '2,14s/^# \{0,1\}//p' "$0"
  exit 0
}

olla_url="http://127.0.0.1:40114"
olla_config="$HOME/.config/olla/config.yaml"
# By title: item ids change on key rotation.
op_ref="op://Private/nvidia NIM API key/credential"

restart=false
model="moonshotai/kimi-k3"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m | --model)
      [[ -n "${2:-}" ]] || {
        echo "ccnim: -m requires a model (kimi | flash | pro | nemotron | <id>)" >&2
        exit 1
      }
      # Re-check a model id isn't delisted (a dead id 410s mid-session) before adding a short name here.
      case "$2" in
        kimi) model="moonshotai/kimi-k3" ;;
        flash) model="deepseek-ai/deepseek-v4-flash-0731" ;;
        # Frontier quality but slow per turn; fine for one careful question, not an agent loop.
        pro) model="deepseek-ai/deepseek-v4-pro-0813" ;;
        nemotron) model="nvidia/nemotron-3-ultra-550b-a55b" ;;
        *) model="$2" ;;
      esac
      shift 2
      ;;
    # Long-only: claude owns -r (--resume); a short alias here would swallow it
    # and silently start a new session instead of resuming.
    --restart)
      restart=true
      shift
      ;;
    -h | --help) show_help ;;
    *) break ;;
  esac
done

# Olla returns 404 on / when healthy, so any response means "up"; only a refused
# connection means "down". Do NOT add curl -f (it would treat the healthy 404 as down and loop forever).
olla_up() { curl -s -o /dev/null --max-time 2 "$olla_url/" 2>/dev/null; }

command -v olla >/dev/null || {
  echo "ccnim: 'olla' not found on PATH" >&2
  exit 1
}
[[ -r "$olla_config" ]] || {
  echo "ccnim: Olla config not found: $olla_config" >&2
  exit 1
}

key=$(op read "$op_ref" 2>/dev/null) || {
  echo "ccnim: couldn't read NIM key from 1Password ($op_ref)" >&2
  echo "       Check 'op signin', then that the item still exists (ids change on rotation)." >&2
  exit 1
}
[[ -n "$key" ]] || {
  echo "ccnim: NIM credential is empty in 1Password ($op_ref)" >&2
  exit 1
}

if $restart; then
  pkill -f "olla -c $olla_config" 2>/dev/null || true
  # A bare sleep would race a still-shutting-down daemon and silently skip the restart.
  n=0
  while olla_up && [[ $n -lt 10 ]]; do
    sleep 0.5
    n=$((n + 1))
  done
  if olla_up; then
    echo "ccnim: warning: Olla still on :40114 after restart; it may serve the old model" >&2
  fi
fi

if ! olla_up; then
  API_KEY="$key" nohup olla -c "$olla_config" >/tmp/olla.log 2>&1 &
  olla_pid=$!
  disown
  n=0
  until olla_up; do
    if ! kill -0 "$olla_pid" 2>/dev/null; then
      echo "ccnim: Olla exited during startup:" >&2
      tail -n 15 /tmp/olla.log >&2
      exit 1
    fi
    if [[ $n -ge 20 ]]; then
      echo "ccnim: Olla did not become healthy in 10s (see /tmp/olla.log)" >&2
      exit 1
    fi
    sleep 0.5
    n=$((n + 1))
  done
fi

# No CLAUDE_CODE_MAX_CONTEXT_TOKENS here on purpose: the 200k default is under
# every window served here, so leaving it unset wastes headroom rather than
# overflowing. Setting it for nemotron especially would actively hurt: it would
# raise the autocompact ceiling and push oversized bodies at this endpoint.

# ANTHROPIC_API_KEY (unused value) overrides an active Claude subscription
# login to force this endpoint.
#
# All six model vars: unset, each tier resolves to a hardcoded claude-* literal,
# which Olla 404s, and any plugin agent pinning a tier fails mid-session.
#
# MAX_CONCURRENT_SUBAGENTS caps the burst at 4 (default 20) to stay under NIM's
# soft concurrency gate. This does not fix the punitive per-minute rate cap —
# that needs concurrency below 1, so it only delays a lockout. There is nothing
# to react to either: a 429 carries no Retry-After, and a 200 can still hide an
# in-stream ResourceExhausted frame.
ANTHROPIC_BASE_URL="$olla_url/olla/anthropic" \
  ANTHROPIC_API_KEY="olla" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_SMALL_FAST_MODEL="$model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$model" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$model" \
  ANTHROPIC_DEFAULT_FABLE_MODEL="$model" \
  CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS="${CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS:-4}" \
  exec claude "$@"
