{
  "description": "The Claude Code guards from .claude/settings.json; tests/test-codex-hooks.sh keeps the two equal.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/search-tool-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/commit-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/hook-bypass-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-pr-review.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pending-review-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pending-review-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Developer/_dotfiles/bin/record-review",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer-agent.sh working",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer-agent.sh approval",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer-agent.sh done",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer-agent.sh end",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
