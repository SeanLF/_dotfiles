#!/bin/bash
# Global commit-msg, applied to every repo via core.hooksPath.
# check-commit-msg is trusted from its fixed path in _dotfiles; lefthook.yml
# is repo-controlled and gated behind the same opt-in the other hooks use.
set -euo pipefail

CHECK="$HOME/Developer/_dotfiles/bin/check-commit-msg"
[ -x "$CHECK" ] && "$CHECK" "$1"

if [ -f lefthook.yml ] &&
  [ "$(git config --local --bool hooks.lefthook 2>/dev/null || echo false)" = "true" ] &&
  command -v lefthook >/dev/null 2>&1; then
  lefthook run --no-auto-install commit-msg "$@" || exit $?
fi
