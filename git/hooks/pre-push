#!/bin/bash
# Global pre-push: the review gate for Claude-made changes, then lefthook.
#
# SECURITY: lefthook.yml is repo-controlled and runs arbitrary commands. Git
# never clones .git/hooks precisely so that cloning cannot execute a repo's
# code, so delegation needs per-repo opt-in:  git config --local hooks.lefthook true
# Read at --local scope deliberately: a global value would trust every repo.
set -euo pipefail

# Both consumers read the ref list from stdin; capture it once.
REFS=$(cat)

# Fixed path in _dotfiles, so it is trusted whichever repo we are standing in.
# Inert unless CLAUDECODE=1.
GATE="${REVIEW_GATE_BIN:-$HOME/Developer/_dotfiles/bin/review-gate}"
if [ -x "$GATE" ]; then
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac # deleting a remote ref
    "$GATE" --push "$local_sha" "$remote_sha" || exit 1
  done <<EOF
$REFS
EOF
elif [ -e "$GATE" ]; then
  echo "pre-push: $GATE exists but is not executable, so the review gate is not running." >&2
fi

[ -f lefthook.yml ] || exit 0
if [ "$(git config --local --bool hooks.lefthook 2>/dev/null || echo false)" != "true" ]; then
  echo "pre-push: lefthook.yml present but this repo is not trusted to run it." >&2
  echo "  if you trust it: git config --local hooks.lefthook true" >&2
  exit 0
fi
command -v lefthook >/dev/null 2>&1 || exit 0
printf '%s\n' "$REFS" | lefthook run --no-auto-install pre-push "$@"
