#!/bin/bash
# Global pre-commit. core.hooksPath replaces the whole hooks directory, so this must
# hand off to lefthook or repos relying on it silently lose their checks.
#
# SECURITY: lefthook.yml is repo-controlled and runs arbitrary commands. Git
# never clones .git/hooks precisely so that cloning cannot execute a repo's
# code. Delegating unconditionally from a global hook hands that protection
# back, so delegation needs per-repo opt-in. `git clone` does not import the
# source repo's local config, which is what makes this a real boundary.
#
# Trust a repo with:  git config --local hooks.lefthook true
# Read at --local scope deliberately: a global value would trust every repo,
# including hostile clones, from a single accidental setting.
set -euo pipefail

# lefthook runs first and is no longer exec'd. The review gate below has to see
# the tree after formatters, or it certifies code that never lands.
if [ -f lefthook.yml ]; then
  if [ "$(git config --local --bool hooks.lefthook 2>/dev/null || echo false)" != "true" ]; then
    echo "pre-commit: lefthook.yml present but this repo is not trusted to run it." >&2
    echo "  if you trust it: git config --local hooks.lefthook true" >&2
  elif command -v lefthook >/dev/null 2>&1; then
    lefthook run --no-auto-install pre-commit "$@"
  fi
fi

# Fixed path in _dotfiles, so it is trusted whichever repo we are standing in,
# same as check-commit-msg. Inert unless CLAUDECODE=1.
#
# An `if`, not `[ -x ] && "$GATE"`: as the last line of a `set -e` script the &&
# form exits 1 whenever the gate is absent, blocking every commit on a machine
# that has not installed it yet.
GATE="${REVIEW_GATE_BIN:-$HOME/Developer/_dotfiles/bin/review-gate}"
if [ -x "$GATE" ]; then
  "$GATE"
elif [ -e "$GATE" ]; then
  # Present but not executable is not a fresh machine, it is a gate that has
  # been switched off. Absent is silent; this is not.
  echo "pre-commit: $GATE exists but is not executable, so the review gate is not running." >&2
fi
