#!/bin/bash
# Global post-commit: clears the review gate's escape hatch, and hands off to
# lefthook. See pre-commit for the lefthook trust boundary.
set -euo pipefail

# Do not rename to GIT_DIR: git exports that into hooks inside a linked worktree,
# and assigning it repoints every later git call, including lefthook's.
COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null) || COMMON_DIR=""
[ -n "$COMMON_DIR" ] && rm -f "$COMMON_DIR/claude-review-force"

# Do not make this handoff unconditional: it prints a lefthook banner on every
# commit machine-wide, and no repo here has a post-commit section.
if [ -f lefthook.yml ] &&
  grep -q '^post-commit:' lefthook.yml &&
  [ "$(git config --local --bool hooks.lefthook 2>/dev/null || echo false)" = "true" ] &&
  command -v lefthook >/dev/null 2>&1; then
  lefthook run --no-auto-install post-commit "$@" || exit $?
fi
exit 0
