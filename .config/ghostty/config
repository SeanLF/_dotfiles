# Ghostty Configuration

# Automatically switch between light and dark themes based on system appearance
theme = light:Rose Pine Dawn,dark:Rose Pine

# macOS: Integrate tabs into titlebar for cleaner look
macos-titlebar-style = tabs

# Start zoomed: 4 cmd+= steps above Ghostty's default 13 (each step is 1pt)
font-size = 17

# Window size and padding
window-height = 1080
window-width = 1920
window-padding-x = 8
window-padding-y = 8

# Shell integration for enhanced features
shell-integration = detect

# Keybindings
keybind = shift+enter=text:\x1b\r
keybind = opt+backspace=text:\x17

# Update channel
auto-update-channel = tip
