+// RewriteModelInBody splices an explicit model name into the top-level "model"
+// field of a JSON request body, reusing the same targeted byte-splice logic as
+// RewriteModelForAlias so the result is byte-identical to the input except for the
+// model name. Unlike RewriteModelForAlias it takes the model name directly (rather
+// than resolving it from the alias map in context), which is what the same-endpoint
+// failover loop needs to try successive models from an alias chain.
+//
+// Returns the body unchanged when it is not a JSON object with a top-level string
+// "model" field, or when model is empty.
+func RewriteModelInBody(body []byte, model string) []byte {
+	if model == "" {
+		return body
+	}
+	return rewriteModelField(body, model)
+}
