+// retryOnStatus lists backend HTTP status codes that trigger same-endpoint,
+// next-model failover for alias-resolved requests.
+// TODO: make configurable via retry_on_status
+var retryOnStatus = map[int]bool{429: true}
+
+// failoverModels returns the ordered list of actual model names to try for this
+// endpoint, starting with the model currently selected for it. When the alias's
+// ordered chain is present in context, the returned slice is the suffix of that
+// chain beginning at the current model, so callers fail over to subsequent models
+// on the same endpoint. Returns a single-element slice (today's behaviour, with an
+// empty string meaning "don't rewrite") when no chain is configured.
+func failoverModels(ctx context.Context, endpoint *domain.Endpoint) []string {
+	aliasMap, _ := ctx.Value(constants.ContextModelAliasMapKey).(map[string]string)
+	current := aliasMap[endpoint.GetURLString()]
+
+	chain, _ := ctx.Value(constants.ContextAliasModelChainKey).([]string)
+	if len(chain) == 0 {
+		return []string{current}
+	}
+
+	// Start at the current model's position so we only fail over to models that
+	// come after it in the alias's ordered list.
+	start := 0
+	for i, m := range chain {
+		if m == current {
+			start = i
+			break
+		}
+	}
+	return chain[start:]
+}
