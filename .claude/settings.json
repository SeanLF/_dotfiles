{
  "cleanupPeriodDays": 100000,
  "permissions": {
    "deny": ["Bash(git push --no-verify *)", "Bash(git push * --no-verify*)"],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/ccpool warn"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/steer.sh working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer.sh approval"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer.sh idle"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer.sh done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/steer.sh end"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Developer/_dotfiles/bin/record-review"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/ccpool warn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/search-tool-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/email-guard.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "/opt/homebrew/bin/ccpool statusline",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "typesafe@typesafe-ai": true,
    "via@claude-code-subagent-harnesses": true
  },
  "extraKnownMarketplaces": {
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "claude-code-subagent-harnesses": {
      "source": {
        "source": "github",
        "repo": "SeanLF/claude-code-subagent-harnesses"
      },
      "autoUpdate": true
    }
  },
  "feedbackDrafts": "off",
  "pluginConfigs": {
    "via@claude-code-subagent-harnesses": {
      "options": {
        "timeoutMinutes": 55
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
